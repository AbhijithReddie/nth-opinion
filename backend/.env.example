# Copy this file to backend/.env and fill in real values. Never commit .env.

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Optional: a second model to try when GEMINI_MODEL is overloaded (503) or out
# of quota (429), e.g. gemini-3.5-flash. Leave empty to disable.
GEMINI_FALLBACK_MODEL=
# Optional: the models to try, in order, comma-separated. When set, it replaces
# GEMINI_MODEL and GEMINI_FALLBACK_MODEL. The free tier allows about 20 requests
# per day PER MODEL, so a chain of several models goes further. A model that runs
# out of quota is skipped (no requests sent) until its quota resets at midnight
# Pacific time; one that's only rate limited per minute, for the delay Gemini asks.
# Example: GEMINI_MODEL_CHAIN=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODEL_CHAIN=
# Optional: the model used by room directors (who speaks next) and the safety
# check. Leave empty to use the first model; it falls back along the chain too.
DIRECTOR_MODEL=
# Optional: fewer AI calls per room turn. The director plans the whole turn in
# one call (who speaks or reacts, in order) instead of being asked again before
# every message: about half the calls. Set to true to turn it on.
ROOM_FAST_MODE=false
# Optional: the LLM judge for the evaluation suites (python -m evals.run). Use a
# different model from the one being tested, so the judge isn't grading itself.
# Leave empty to use the second model in the chain (or GEMINI_MODEL). The judge
# never falls back to other models.
JUDGE_MODEL=

# LangSmith tracing (optional - set LANGSMITH_TRACING=false to disable)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=debate-arena

# Allowed CORS origins for the frontend, comma-separated
FRONTEND_ORIGIN=http://localhost:3000
