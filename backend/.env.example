# Copy this file to backend/.env and fill in real values. Never commit .env.

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Optional: a model to retry with once when GEMINI_MODEL is overloaded (503) or
# rate limited (429), e.g. gemini-3.5-flash. Leave empty to disable.
GEMINI_FALLBACK_MODEL=
# Optional: the model used by room directors (who speaks next) and the safety
# check. Leave empty to use GEMINI_MODEL.
DIRECTOR_MODEL=

# LangSmith tracing (optional - set LANGSMITH_TRACING=false to disable)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=debate-arena

# Allowed CORS origins for the frontend, comma-separated
FRONTEND_ORIGIN=http://localhost:3000
