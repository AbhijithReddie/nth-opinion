# URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this site (no trailing slash): the base for link previews (Open Graph / Twitter
# images) and the address printed on share cards. Defaults to https://nth-opinion.vercel.app.
NEXT_PUBLIC_SITE_URL=https://nth-opinion.vercel.app

# Optional accounts (Supabase Auth only; the backend does all database access).
# Leave empty to hide "Sign in": everything works for guests as before.
# Project Settings > API: the project URL and the publishable key (starts with "sb_publishable_"),
# used wherever Supabase expects the anon key. Never put a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
